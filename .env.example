# Generate a long, random value before exposing the service.
EXOTEL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Optional HMAC-SHA256 secret. If set, the X-Exotel-Signature header is checked.
EXOTEL_SIGNATURE_SECRET=
# Required for Bhashini audio-language detection, ASR, translation, and TTS.
# The legacy ULCA fields are retained because some Bhashini accounts use them
# during pipeline configuration. Live inference uses BHASHINI_INFERENCE_API_KEY.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_ALD_PIPELINE_ID=ai4bharat/spoken-language-identification
# Use these when ASR and TTS use distinct Bhashini service IDs.
BHASHINI_STT_PIPELINE_ID=
BHASHINI_TTS_PIPELINE_ID=
BHASHINI_TRANSLATION_PIPELINE_ID=ai4bharat/indictrans-v2-all-gpu--t4
BHASHINI_TTS_GENDER=female
# Output script mode: "native" (recommended: native Unicode script with Latin technical terms) or "roman"
BHASHINI_TTS_SCRIPT_MODE=native
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
SERVER_BASE_URL=https://geometry-gilled-swirl.ngrok-free.dev
VAD_RMS_THRESHOLD=400
VAD_SILENCE_SECONDS=0.9
RAG_QUERY_TIMEOUT_SECONDS=8.0
# Default caller language when ALD is inconclusive or classifies code-mixed speech as en-IN.
DEFAULT_CALLER_LANGUAGE=te-IN
# True = answer with the RAG/LLM knowledge base before speaking the reply.
LIVE_RAG_ENABLED=true
# 0 matches the sample rate negotiated by Exotel (recommended). Use 8000/16000
# only when your Voicebot applet is configured for a fixed playback rate.
EXOTEL_PLAYBACK_SAMPLE_RATE=0
# Required when enabling the attached SignalMinds ChromaDB/Groq RAG middleware.
GROQ_API_KEY=
# Used for direct general-knowledge fallback when the PDF does not cover a query.
# Groq's fast developer-tier model. Use openai/gpt-oss-120b for higher quality.
GROQ_MODEL=openai/gpt-oss-20b
RAG_MIN_RETRIEVAL_SCORE=2
# Set this in production. Comma-separated hostnames allowed for RecordingUrl.
RECORDING_ALLOWED_HOSTS=
RECORDINGS_DIRECTORY=./data/recordings
MAX_RECORDING_BYTES=52428800
LOG_LEVEL=INFO
