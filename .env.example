# Generate a long, random value before exposing the service.
EXOTEL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Optional HMAC-SHA256 secret. If set, the X-Exotel-Signature header is checked.
EXOTEL_SIGNATURE_SECRET=
# Required for automatic Sarvam STT and English translation after a WAV is saved.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Female Bulbul v3 voice. Other supported choices can be set here later.
SARVAM_TTS_SPEAKER=ishita
VAD_RMS_THRESHOLD=400
VAD_SILENCE_SECONDS=2.0
RAG_QUERY_TIMEOUT_SECONDS=15.0
# True = answer with the RAG/LLM knowledge base before speaking the reply.
LIVE_RAG_ENABLED=true
# 0 matches the sample rate negotiated by Exotel (recommended). Use 8000/16000
# only when your Voicebot applet is configured for a fixed playback rate.
EXOTEL_PLAYBACK_SAMPLE_RATE=0
# Required when enabling the attached SignalMinds ChromaDB/Groq RAG middleware.
GROQ_API_KEY=
# Used for direct general-knowledge fallback when the PDF does not cover a query.
# Groq's fast developer-tier model. Use openai/gpt-oss-120b for higher quality.
GROQ_MODEL=openai/gpt-oss-20b
RAG_MIN_RETRIEVAL_SCORE=2
# Set this in production. Comma-separated hostnames allowed for RecordingUrl.
RECORDING_ALLOWED_HOSTS=
RECORDINGS_DIRECTORY=./data/recordings
MAX_RECORDING_BYTES=52428800
LOG_LEVEL=INFO
