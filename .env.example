# Generate a long, random value before exposing the service.
EXOTEL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Optional HMAC-SHA256 secret. If set, the X-Exotel-Signature header is checked.
EXOTEL_SIGNATURE_SECRET=
# Set this in production. Comma-separated hostnames allowed for RecordingUrl.
RECORDING_ALLOWED_HOSTS=
RECORDINGS_DIRECTORY=./data/recordings
MAX_RECORDING_BYTES=52428800
LOG_LEVEL=INFO

